# Environment Variables Template
# Copy this file to .env and fill in actual values
# NOTE: .env is in .gitignore and should NEVER be committed to version control

# Core Configuration
ADMIN_PASSWORD=your-secure-password-here
FLASK_DEBUG=0
RENDER=false

# Port Configuration (default: 3000 for local development)
# PORT is typically set by Render automatically in production
PORT=3000

# Async Mode Configuration
# Set to true for production with async workers
ASYNC_MODE=false

# Monkey Patching for Async Support
# Only needed for gevent-based async
GEVENT_MONKEY_PATCH=false

# Only needed for eventlet-based async
EVENTLET_MONKEY_PATCH=false

# Session Configuration (Added for security, reserved for future use)
# SESSION_SECRET_KEY=your-session-secret-key-here
